# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<web push public key from `npx web-push generate-vapid-keys`>

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service role key; used only by /api/admin/users to invite users>
